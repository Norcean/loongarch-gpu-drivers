# Contributor: zint <zint@tuta.io>

pkgname=loonggpu-driver
pkgver=1.0.2
_pkgver=${pkgver}-lnd25.1
pkgrel=1
pkgdesc="LOONGGPU metapackage — installs the complete loonggpu graphics driver suite"
license=('custom:LOONGGPU')
arch=(loong64)
makedepends=(
	libarchive
	)
depends=(
	linux-firmware-loongson
	libldrm
	libloong-gpucomp
	loonggl
	loonggpu-dkms
	xf86-video-loonggpu
)
options=(!debug !strip)
source=(
	"https://repos.loongson.cn/loonggpu/repos/loongnix25/loonggpu-driver_${_pkgver}_${arch}.deb"
)
b2sums=(
	'af64b41ac29f7ae31fed94739162c00684d4db657e455b08b9466ad37606b79d19d0c1ec53530363fce86d4b79c47508b3970234f5f0df37f5e09eb55f47228f'
)

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	# Bug-report / diagnostic script
	install -Dm755 "${srcdir}/usr/share/bug/loonggpu-driver/script" \
		"${pkgdir}/usr/share/bug/loonggpu-driver/script"

	# Documentation
	install -Dm644 "${srcdir}/usr/share/doc/loonggpu-driver/copyright" \
		"${pkgdir}/usr/share/doc/loonggpu-driver/copyright"
}
