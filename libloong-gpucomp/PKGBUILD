pkgname=libloong-gpucomp
pkgver=1.0.2
_pkgver=${pkgver}-0kylin1
pkgrel=1
pkgdesc="LOONGGPU GPUCOMP runtime library"
license=()
arch=(loong64)
makedepends=(
	binutils
	libarchive
	)
options=(!debug !strip)
source=(
	"https://repos.loongson.cn/loonggpu/repos/kylinv10sp1/libloong-gpucomp_${_pkgver}_loongarch64.deb"
)
b2sums=(
	"3e583f595aa46eb3c821d2b377f174cce50d9347c142e6b3165d4aeacfd01d575e5e2a4d0f62ded72e59bb56cd66af6c51cd13d71313c251373edd862bc9e913"
)

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	install -Dm755 "${srcdir}/usr/lib/loongarch64-linux-gnu/libloong-gpucomp.so.1" "${pkgdir}/usr/lib/libloong-gpucomp.so.1"

	install -Dm644 ${srcdir}/usr/share/doc/libloong-gpucomp/copyright ${pkgdir}/usr/share/doc/libloong-gpucomp/copyright
}
