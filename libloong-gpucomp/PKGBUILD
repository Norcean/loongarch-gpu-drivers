# Contributor: zint <zint@tuta.io>

pkgname=libloong-gpucomp
pkgver=1.0.2
_pkgver=${pkgver}-lnd25.1
pkgrel=1
pkgdesc="LOONGGPU GPUCOMP runtime library"
license=('custom:LOONGGPU')
arch=(loong64)
makedepends=(
	binutils
	libarchive
	)
options=(!debug !strip)
source=(
	"https://repos.loongson.cn/loonggpu/repos/loongnix25/libloong-gpucomp_${_pkgver}_${arch}.deb"
)
b2sums=(
	"f63cdd90b9729d22de2e016d8d580491060394db59258b595597e90f25f911597ece33ce827360e764822e642da6cf98bdf85a3688d604bd01cc68781cc11970"
)

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	install -Dm755 "${srcdir}/usr/lib/loongarch64-linux-gnu/libloong-gpucomp.so.1" "${pkgdir}/usr/lib/libloong-gpucomp.so.1"

	install -Dm644 "${srcdir}/usr/share/doc/libloong-gpucomp/copyright" "${pkgdir}/usr/share/doc/libloong-gpucomp/copyright"
}
