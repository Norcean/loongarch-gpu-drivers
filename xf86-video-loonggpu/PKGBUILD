# Maintainer: zint <zint@tuta.io>
# Contributor: zint <zint@tuta.io>

pkgname=xf86-video-loonggpu
pkgver=1.0.2
_pkgver=${pkgver}-lnd25.1
pkgrel=1
pkgdesc="LOONGGPU binary Xorg driver
 loonggpu is an Xorg video driver for the kernel driver which name is the
 value of \"MatchDriver\" in 20-loonggpu.conf. Note that 3D acceleration is
 available through enable the EXA layer. If the fake EXA accerelation is
 not enabled, then this driver will fallback to shadowfb. This driver
 supports TrueColor visuals at framebuffer depths of 15, 16, 24, and 30.
 This package is build from the X.org xf86-video-loonggpu driver module."
license=('custom:LOONGGPU')
arch=(loong64)
makedepends=(
	binutils
	libarchive
	)
depends=(
	libedit
	libldrm
	loonggl
	)
options=(!debug !strip)
source=(
	"https://repos.loongson.cn/loonggpu/repos/loongnix25/xserver-xorg-video-loonggpu_${_pkgver}_${arch}.deb"
)
b2sums=('e794cba347de3ad79ff138e7c513c3b5209d8eaa7967ccf31c0b44ee3fdbcf2167dccc624f28b44e450a63588fee233779f61bd5efce3a87bf78d8477dd204a7')

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	# Xorg driver
	install -Dm755 "${srcdir}/usr/lib/xorg/modules/drivers/loonggpu_drv.so" "${pkgdir}/usr/lib/xorg/modules/drivers/loonggpu_drv.so"

	# loonggpu_drv.so was built against libedit.so.2 on Loongnix;
	# Arch's libedit ships libedit.so so this symlink resolves correctly.
	pushd "${pkgdir}/usr/lib"
	ln -s libedit.so libedit.so.2
	popd

	# DRI driver (gsgpu_dri.so comes from loonggl)
	pushd "${pkgdir}/usr/lib/xorg/modules"
	ln -s ../../dri/gsgpu_dri.so
	popd

	# Shared data (man pages, Xorg config snippets, etc.)
	cp -r "${srcdir}/usr/share" "${pkgdir}/usr/"

	# Driver configuration (3D settings)
	install -dm755 "${pkgdir}/etc/loonggpu"
	cat > "${pkgdir}/etc/loonggpu/loonggpu_driver.conf" <<-EOF
		Section "3D"
		Option  "highPerformanceState"  "false"
		EndSection
	EOF
	chmod 644 "${pkgdir}/etc/loonggpu/loonggpu_driver.conf"
}
