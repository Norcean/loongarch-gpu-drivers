# Contributor: zint <zint@tuta.io>

pkgname=linux-firmware-loongson
pkgver=1.0.2
_pkgver=${pkgver}-lnd25.1
pkgrel=1
pkgdesc="This package contains the binary firmware (lg100/lg200) for loongson graphics chips supported by the loonggpu drivers."
license=('custom:LOONGGPU')
arch=(loong64)
makedepends=(
	libarchive
	)
options=(!debug !strip)
source=("https://repos.loongson.cn/loonggpu/repos/loongnix25/firmware-loongson-graphics_${_pkgver}_${arch}.deb")
b2sums=("7a21c1ea17a211d0f95cd3dea6272c6305edded1fb576a75bb108de115eb379abb941ff36278b399262f0a6f4499de41f0439ca19e00394bd20f42b740395394")

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	install -Dm644 "${srcdir}/lib/firmware/loonggpu/lg100_cp.bin"  "${pkgdir}/usr/lib/firmware/loonggpu/lg100_cp.bin"
	install -Dm644 "${srcdir}/lib/firmware/loonggpu/lg200_cp.bin"  "${pkgdir}/usr/lib/firmware/loonggpu/lg200_cp.bin"

	install -Dm644 "${srcdir}/usr/share/doc/firmware-loongson-graphics/copyright" "${pkgdir}/usr/share/doc/firmware-loongson-graphics/copyright"
}
