pkgname=linux-firmware-loongson
pkgver=1.0.2
_pkgver=${pkgver}-0kylin1
pkgrel=2
pkgdesc="This package contains the binary firmware for loongson graphics chips supported by the gsgpu drivers."
license=()
arch=(loong64)
makedepends=(
	zstd
	)
options=(!debug !strip)
source=("https://pkg.loongnix.cn/loongnix/25/pool/non-free/l/loonggpu-graphics-drivers/firmware-loongson-graphics_${_pkgver}_loongarch64.deb")
b2sums=("d0f3e69815f258409ef957bf3493dd7b20f3f7cafd5a59b11a38ae7aa2ea133c039eff01ebba916e633af8d4e9b825332a3e64ee60ba5dd62fcf44db97bb5efd")

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	install -Dm644 ${srcdir}/lib/firmware/loonggpu/lg100_cp.bin ${pkgdir}/usr/lib/firmware/loonggpu/lg100_cp.bin

	install -Dm644 ${srcdir}/usr/share/doc/firmware-loongson-graphics/copyright ${pkgdir}/usr/share/doc/firmware-loongson-graphics/copyright
}
