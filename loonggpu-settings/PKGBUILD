# Contributor: zint <zint@tuta.io>

pkgname=loonggpu-settings
pkgver=1.0.2
_pkgver=${pkgver}-lnd25.1~rc1.7
pkgrel=1
pkgdesc="LOONGGPU Xorg driver configuration (3D settings)
 This package provides the configuration file for the loonggpu Xorg
 driver in /etc/loonggpu/loonggpu_driver.conf, controlling 3D
 acceleration settings like high-performance state."
license=('custom:LOONGGPU')
arch=(loong64)
makedepends=(
	libarchive
	)
options=(!debug !strip)
source=(
	"https://pkg.loongnix.cn/loongnix/25/pool/non-free/l/loonggpu-graphics-drivers/loonggpu-settings_${_pkgver}_${arch}.deb"
)
b2sums=(
	'cc8a50596d8b8eaefedbc147b562f8df6e56d955e4f159c76d3fb91526cc2e9efecc96e016ea340e353e95b1f4bdc5b7ff5963cdb9244b8eb01f5a3c8d23cc8c'
)

prepare(){
	bsdtar -xf "${srcdir}/data."*
}
package(){
	# Create loonggpu driver configuration
	install -dm755 "${pkgdir}/etc/loonggpu"
	cat > "${pkgdir}/etc/loonggpu/loonggpu_driver.conf" <<-EOF
		Section "3D"
		Option  "highPerformanceState"  "false"
		EndSection
	EOF
	chmod 644 "${pkgdir}/etc/loonggpu/loonggpu_driver.conf"

	# Documentation
	install -Dm644 "${srcdir}/usr/share/doc/loonggpu-settings/copyright" \
		"${pkgdir}/usr/share/doc/loonggpu-settings/copyright"
}
